{
  "dataset": "Salesforce/wikitext",
  "dataset_config": "wikitext-2-raw-v1",
  "corpus_chars": 200000,
  "bpe_vocab_size": 8192,
  "d_model": 192,
  "n_layer": 4,
  "n_head": 6,
